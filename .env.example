# 复制本文件为 .env 并填入真实密钥；.env 绝不提交
# DeepSeek 平台（默认）
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 通义千问兼容模式（备用）
DASHSCOPE_API_KEY=your_dashscope_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# 如果填写每百万 token 单价，脚本会自动估算费用；价格会调整，请以平台官网为准
DEEPSEEK_INPUT_PRICE_PER_MILLION=
DEEPSEEK_OUTPUT_PRICE_PER_MILLION=
DASHSCOPE_INPUT_PRICE_PER_MILLION=
DASHSCOPE_OUTPUT_PRICE_PER_MILLION=